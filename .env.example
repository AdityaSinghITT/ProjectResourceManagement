DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"
PORT=3000
API_BASE_URL=http://localhost:3000
ENABLE_SCHEDULER=false

# Email (Mailtrap recommended for dev) — if unset, emails log to console via appLogger
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-mailtrap-user
# SMTP_PASS=your-mailtrap-pass
# EMAIL_FROM=prm-tool@techserve.local

# LLM — optional bootstrap for first seed only; runtime reads Admin > System Configuration (DB)
# LLM_BASE_URL="http://your-llm-host:11434"
# LLM_API_KEY="your-bearer-token-if-required"
# LLM_MODEL="gemma3:12b-it-q8_0"
# LLM_PROVIDER=OLLAMA
