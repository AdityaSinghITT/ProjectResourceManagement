DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"
PORT=3000
API_BASE_URL=http://localhost:3000
ENABLE_SCHEDULER=false

